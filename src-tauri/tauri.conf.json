{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LazySwitch",
  "version": "0.1.1",
  "identifier": "com.local.lazyswitch",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
